{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:findmind:pass-t:phase2a:v2:event-gt-response",
  "title": "FindMind Pass T Event GT response V2",
  "description": "A separate exploratory DEV human-response contract. Cross-frame, visual, provenance, approval and immutable-storage rules require Stage B semantic validation against the frozen policy and review item manifest. V2 adds confirmed-event-only exhaustiveness with explicit limited-ontology human attestation and coverage; semantic evaluation eligibility remains subject to existing exclusions.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "PASS_T_EVENT_GT_V2"
    },
    "annotation_item_id": {
      "type": "string",
      "pattern": "^PT2A_[0-9a-f]{16}$"
    },
    "review_round": {
      "enum": [
        1,
        2
      ]
    },
    "relabel_of": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "target_reference": {
      "type": "object",
      "properties": {
        "selected_local_candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "stratum": {
          "enum": [
            "SOURCE_RESOLVED_DEV",
            "HUMAN_SEEDED_DEV",
            "EXCLUDED_OR_UNRESOLVED"
          ]
        }
      },
      "required": [
        "selected_local_candidate_id",
        "stratum"
      ],
      "additionalProperties": false
    },
    "window_outcome": {
      "enum": [
        "CONFIRMED_EVENTS",
        "NO_CONFIRMED_EVENT",
        "INSUFFICIENT_EVIDENCE",
        "TARGET_NOT_OBSERVABLE"
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "unmodeled_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unmodeled"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "observation_coverage_frame_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^S[0-9]{6}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "coverage_citations": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/citation"
          },
          {
            "properties": {
              "role": {
                "const": "COVERAGE"
              }
            }
          }
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "coverage_assessment": {
      "enum": [
        "THROUGHOUT_ASSESSABLE",
        "GAPS_OR_UNCERTAINTY",
        "UNKNOWN"
      ]
    },
    "last_confirmed_state": {
      "enum": [
        "ON_SURFACE",
        "HELD_BY_PERSON",
        "OTHER_OBSERVED",
        "STATE_UNKNOWN"
      ]
    },
    "last_confirmed_state_description": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "last_confirmed_frame_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^S[0-9]{6}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_confirmed_timestamp": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "last_confirmed_state_evidence": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/citation"
          },
          {
            "properties": {
              "role": {
                "const": "STATE"
              }
            }
          }
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "last_confirmed_location_description": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "location_marker": {
      "anyOf": [
        {
          "$ref": "#/$defs/location_marker"
        },
        {
          "type": "null"
        }
      ]
    },
    "location_evidence_frame_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^S[0-9]{6}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "visibility_at_window_end": {
      "$ref": "#/$defs/visibility_at_window_end"
    },
    "unknown_or_unobserved_afterward": {
      "type": "boolean"
    },
    "subsequent_location": {
      "enum": [
        "UNKNOWN",
        "OBSERVED_IN_WINDOW"
      ]
    },
    "subsequent_location_description": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "subsequent_location_evidence_frame_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^S[0-9]{6}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "subsequent_location_evidence": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/citation"
          },
          {
            "properties": {
              "role": {
                "const": "STATE"
              }
            }
          }
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "target_identification_event_dependence": {
      "enum": [
        "NOT_DEPENDENT",
        "PARTIALLY_DEPENDENT",
        "DEPENDENT",
        "UNKNOWN"
      ]
    },
    "target_identification_event_dependence_rationale": {
      "type": "string",
      "minLength": 1
    },
    "same_reviewer_as_phase1c": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "target_recognition_used_pre_window_reference": {
      "type": "boolean"
    },
    "uncertainty": {
      "$ref": "#/$defs/uncertainty"
    },
    "confidence": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN"
      ]
    },
    "human_rationale": {
      "type": "string",
      "minLength": 1
    },
    "attestations": {
      "$ref": "#/$defs/attestations"
    },
    "interaction_metadata": {
      "type": "object",
      "properties": {
        "initial_overlay_mode": {
          "const": "SELECTED_CANDIDATE_ONLY"
        },
        "references_opened": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^R[0-9]{6}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "overlay_toggles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "timestamp_utc": {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$"
              },
              "mode": {
                "enum": [
                  "OFF",
                  "SELECTED_CANDIDATE_ONLY",
                  "ALL_CANDIDATES"
                ]
              }
            },
            "required": [
              "timestamp_utc",
              "mode"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "metadata_is_advisory": {
          "const": true
        }
      },
      "required": [
        "initial_overlay_mode",
        "references_opened",
        "overlay_toggles",
        "metadata_is_advisory"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "event_list_exhaustiveness": {
      "enum": [
        "EXHAUSTIVE_ATTESTED",
        "NOT_ATTESTED",
        "UNKNOWN"
      ]
    },
    "event_list_exhaustiveness_attestation": {
      "$ref": "#/$defs/event_list_exhaustiveness_attestation"
    }
  },
  "required": [
    "schema_version",
    "annotation_item_id",
    "review_round",
    "relabel_of",
    "reviewer_id",
    "target_reference",
    "window_outcome",
    "events",
    "unmodeled_observations",
    "observation_coverage_frame_ids",
    "coverage_citations",
    "coverage_assessment",
    "last_confirmed_state",
    "last_confirmed_state_description",
    "last_confirmed_frame_id",
    "last_confirmed_timestamp",
    "last_confirmed_state_evidence",
    "last_confirmed_location_description",
    "location_marker",
    "location_evidence_frame_ids",
    "visibility_at_window_end",
    "unknown_or_unobserved_afterward",
    "subsequent_location",
    "subsequent_location_description",
    "subsequent_location_evidence_frame_ids",
    "subsequent_location_evidence",
    "target_identification_event_dependence",
    "target_identification_event_dependence_rationale",
    "same_reviewer_as_phase1c",
    "target_recognition_used_pre_window_reference",
    "uncertainty",
    "confidence",
    "human_rationale",
    "attestations",
    "interaction_metadata",
    "provenance"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "properties": {
        "frame_id": {
          "type": "string",
          "pattern": "^S[0-9]{6}$"
        },
        "source_timestamp_s": {
          "type": "number",
          "minimum": 0
        },
        "role": {
          "enum": [
            "BEFORE",
            "TRANSITION",
            "AFTER",
            "STATE",
            "COVERAGE"
          ]
        },
        "kind": {
          "enum": [
            "CANDIDATE_OBSERVATION_BACKED",
            "DIRECT_VISUAL_ONLY"
          ]
        },
        "source_observation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "visual_description": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "target_association": {
          "enum": [
            "SUPPORTED",
            "AMBIGUOUS",
            "NOT_VISIBLE",
            "UNKNOWN"
          ]
        }
      },
      "required": [
        "frame_id",
        "source_timestamp_s",
        "role",
        "kind",
        "source_observation_ids",
        "visual_description",
        "target_association"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "CANDIDATE_OBSERVATION_BACKED"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "source_observation_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "DIRECT_VISUAL_ONLY"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "source_observation_ids": {
                "maxItems": 0
              },
              "visual_description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "uncertainty": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "NO_ADDITIONAL_UNCERTAINTY",
            "TIMING_UNCERTAIN",
            "OTHER_UNCERTAINTY",
            "UNKNOWN"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "description"
      ],
      "additionalProperties": false
    },
    "observed_state": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "ON_SURFACE",
            "HELD_BY_PERSON",
            "OTHER_OBSERVED",
            "STATE_UNKNOWN"
          ]
        },
        "frame_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^S[0-9]{6}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_timestamp_s": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/citation"
              },
              {
                "properties": {
                  "role": {
                    "const": "STATE"
                  }
                }
              }
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "state",
        "frame_id",
        "source_timestamp_s",
        "description",
        "evidence"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "ON_SURFACE",
                  "HELD_BY_PERSON",
                  "OTHER_OBSERVED"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "frame_id": {
                "type": "string",
                "pattern": "^S[0-9]{6}$"
              },
              "source_timestamp_s": {
                "type": "number",
                "minimum": 0
              },
              "evidence": {
                "minItems": 1,
                "items": {
                  "allOf": [
                    {
                      "allOf": [
                        {
                          "$ref": "#/$defs/citation"
                        },
                        {
                          "properties": {
                            "role": {
                              "const": "STATE"
                            }
                          }
                        }
                      ]
                    },
                    {
                      "properties": {
                        "target_association": {
                          "const": "SUPPORTED"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "OTHER_OBSERVED"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "frame_id": {
                "const": null
              }
            },
            "required": [
              "frame_id"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "const": "STATE_UNKNOWN"
              },
              "source_timestamp_s": {
                "type": "null"
              },
              "evidence": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "frame_id": {
                "type": "string",
                "pattern": "^S[0-9]{6}$"
              }
            },
            "required": [
              "frame_id"
            ]
          },
          "then": {
            "properties": {
              "source_timestamp_s": {
                "type": "number",
                "minimum": 0
              },
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "event_time": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "EXACT_OBSERVED_TRANSITION",
            "BOUNDED_BY_BEFORE_AFTER_EVIDENCE",
            "TIMING_UNCERTAIN"
          ]
        },
        "start_frame_id": {
          "type": "string",
          "pattern": "^S[0-9]{6}$"
        },
        "end_frame_id": {
          "type": "string",
          "pattern": "^S[0-9]{6}$"
        },
        "start_timestamp_s": {
          "type": "number",
          "minimum": 0
        },
        "end_timestamp_s": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "status",
        "start_frame_id",
        "end_frame_id",
        "start_timestamp_s",
        "end_timestamp_s"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "annotation_item_id": {
          "type": "string",
          "pattern": "^PT2A_[0-9a-f]{16}$"
        },
        "event_id": {
          "type": "string",
          "pattern": "^EVT[0-9]{3}$"
        },
        "event_type": {
          "enum": [
            "PICKUP",
            "PLACEMENT"
          ]
        },
        "local_candidate_reference": {
          "type": "string",
          "minLength": 1
        },
        "event_time": {
          "$ref": "#/$defs/event_time"
        },
        "evidence": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/citation"
              },
              {
                "properties": {
                  "target_association": {
                    "const": "SUPPORTED"
                  }
                }
              }
            ]
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "observed_actor_reference": {
          "enum": [
            "VISIBLE_PERSON_UNRESOLVED",
            "NOT_OBSERVED",
            null
          ]
        },
        "before_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/observed_state"
            },
            {
              "type": "null"
            }
          ]
        },
        "after_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/observed_state"
            },
            {
              "type": "null"
            }
          ]
        },
        "uncertainty": {
          "$ref": "#/$defs/uncertainty"
        },
        "confidence": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW",
            "UNKNOWN"
          ]
        },
        "human_rationale": {
          "type": "string",
          "minLength": 1
        },
        "chronology_uncertainty": {
          "type": "boolean"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "annotation_origin": {
              "const": "HUMAN"
            },
            "evidence_scope": {
              "const": "AUTHORIZED_WINDOW_ONLY"
            }
          },
          "required": [
            "annotation_origin",
            "evidence_scope"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "annotation_item_id",
        "event_id",
        "event_type",
        "local_candidate_reference",
        "event_time",
        "evidence",
        "observed_actor_reference",
        "before_state",
        "after_state",
        "uncertainty",
        "confidence",
        "human_rationale",
        "chronology_uncertainty",
        "provenance"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "properties": {
            "evidence": {
              "allOf": [
                {
                  "contains": {
                    "properties": {
                      "role": {
                        "const": "BEFORE"
                      }
                    },
                    "required": [
                      "role"
                    ]
                  },
                  "minContains": 1
                },
                {
                  "contains": {
                    "properties": {
                      "role": {
                        "const": "AFTER"
                      }
                    },
                    "required": [
                      "role"
                    ]
                  },
                  "minContains": 1
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_time": {
                "properties": {
                  "status": {
                    "const": "EXACT_OBSERVED_TRANSITION"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "event_time"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "contains": {
                  "properties": {
                    "role": {
                      "const": "TRANSITION"
                    }
                  },
                  "required": [
                    "role"
                  ]
                },
                "minContains": 1
              }
            }
          }
        }
      ]
    },
    "location_marker": {
      "type": "object",
      "properties": {
        "frame_id": {
          "type": "string",
          "pattern": "^S[0-9]{6}$"
        },
        "kind": {
          "enum": [
            "POINT",
            "BBOX"
          ]
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 2
        },
        "coordinate_system_id": {
          "const": "REVIEW_FRAME_PIXELS_V1"
        },
        "origin": {
          "const": "GUI_DRAWN"
        }
      },
      "required": [
        "frame_id",
        "kind",
        "coordinates",
        "coordinate_system_id",
        "origin"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "POINT"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "coordinates": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "BBOX"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "coordinates": {
                "minItems": 4,
                "maxItems": 4
              }
            }
          }
        }
      ]
    },
    "visibility_at_window_end": {
      "type": "object",
      "properties": {
        "visibility": {
          "enum": [
            "VISIBLE",
            "PARTIALLY_OCCLUDED",
            "NOT_VISIBLE",
            "VISIBILITY_UNKNOWN"
          ]
        },
        "frame_id": {
          "type": "string",
          "pattern": "^S[0-9]{6}$"
        },
        "source_timestamp_s": {
          "type": "number",
          "minimum": 0
        },
        "observed_reason": {
          "enum": [
            "OCCLUDED_BY_OBSERVED_OBJECT",
            "LEFT_FIELD_OF_VIEW_OBSERVED",
            "REASON_UNKNOWN",
            null
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          },
          "minItems": 0
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "visibility",
        "frame_id",
        "source_timestamp_s",
        "observed_reason",
        "evidence",
        "rationale"
      ],
      "additionalProperties": false,

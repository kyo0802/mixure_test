{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PASS_T_PHASE2B_PREDICTION_V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_id", "window_outcome", "window_cited_frame_aliases", "events", "last_directly_supported_state", "end_visibility", "subsequent_state", "rationale", "uncertainty", "safety_assertions"],
  "properties": {
    "schema_version": {"const": "PASS_T_PHASE2B_PREDICTION_V1"},
    "target_id": {"const": "TARGET_A"},
    "window_outcome": {"enum": ["CONFIRMED_EVENTS", "NO_CONFIRMED_EVENT", "INSUFFICIENT_EVIDENCE", "TARGET_NOT_OBSERVABLE"]},
    "window_cited_frame_aliases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^F[0-9]{4}$"}},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "event_type", "timing", "cited_frame_aliases", "before_state", "after_state", "target_association_uncertainty", "timing_uncertainty", "rationale"],
        "properties": {
          "event_id": {"type": "string", "pattern": "^PRED_EVT_[0-9]{3}$"},
          "event_type": {"enum": ["PICKUP", "PLACEMENT"]},
          "timing": {
            "oneOf": [
              {"type": "object", "additionalProperties": false, "required": ["status", "frame_alias"], "properties": {"status": {"const": "EXACT_SUPPLIED_FRAME"}, "frame_alias": {"type": "string", "pattern": "^F[0-9]{4}$"}}},
              {"type": "object", "additionalProperties": false, "required": ["status", "start_frame_alias", "end_frame_alias"], "properties": {"status": {"const": "BOUNDED_SUPPLIED_FRAMES"}, "start_frame_alias": {"type": "string", "pattern": "^F[0-9]{4}$"}, "end_frame_alias": {"type": "string", "pattern": "^F[0-9]{4}$"}}},
              {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"const": "TIMING_UNKNOWN"}}}
            ]
          },
          "cited_frame_aliases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^F[0-9]{4}$"}},
          "before_state": {"$ref": "#/$defs/state"},
          "after_state": {"$ref": "#/$defs/state"},
          "target_association_uncertainty": {"enum": ["NONE", "POSSIBLE", "HIGH"]},
          "timing_uncertainty": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "last_directly_supported_state": {"$ref": "#/$defs/state"},
    "end_visibility": {"enum": ["VISIBLE", "PARTIALLY_VISIBLE", "NOT_VISIBLE", "UNKNOWN"]},
    "subsequent_state": {"const": "UNKNOWN"},
    "rationale": {"type": "string", "minLength": 1},
    "uncertainty": {"type": "string", "minLength": 1},
    "safety_assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["global_identity_claimed", "state_persisted_across_unobserved_interval", "container_or_handover_auto_classified"],
      "properties": {
        "global_identity_claimed": {"const": false},
        "state_persisted_across_unobserved_interval": {"const": false},
        "container_or_handover_auto_classified": {"const": false}
      }
    }
  },
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "supporting_frame_alias"],
      "properties": {
        "state": {"enum": ["ON_SURFACE", "HELD_BY_PERSON", "OTHER_OBSERVED", "STATE_UNKNOWN"]},
        "supporting_frame_alias": {"type": ["string", "null"], "pattern": "^F[0-9]{4}$"}
      }
    }
  }
}
